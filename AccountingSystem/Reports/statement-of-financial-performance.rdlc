                    <TablixCell>
                      <CellContents>
                        <Textbox Name="txtMaintenanceAndOtherOperatingExpensesCurrent">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Sum(IIF(Fields!sub_major_account_group_name.Value &lt;&gt; CStr("Financial Assistance/Subsidy").Trim()
AND Fields!sub_major_account_group_name.Value &lt;&gt; CStr("Transfers").Trim()
AND Fields!major_account_group_name.Value = CStr("Maintenance and Other Operating Expenses"),
CDbl(Fields!current_amount.Value), 0)) - Sum(IIF(Fields!sub_major_account_group_name.Value = CStr("Taxes, Insurance Premiums and Other Fees")
AND Fields!sub_major_account_group_name.Value = CStr("Other Maintenance and Operating Expenses"),
CDbl(Fields!current_amount.Value), 0))</Value>
                                  <Style>
                                    <FontFamily>Calibri</FontFamily>
                                    <FontSize>9pt</FontSize>
                                    <Format>#,0.00;(#,0.00);'-'</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Center</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
