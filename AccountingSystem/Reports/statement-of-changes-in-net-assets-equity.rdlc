-(Sum(IIF(Fields!sub_major_account_group_name.Value = CStr("Financial Assistance/Subsidy").Trim() 
OR Fields!sub_major_account_group_name.Value = CStr("Transfers").Trim(), 
CDbl(Fields!previous_amount.Value), 0))))</Value>
                                  <Style>
