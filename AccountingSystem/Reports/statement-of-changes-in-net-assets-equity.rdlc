                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                        <ColSpan>2</ColSpan>
                      </CellContents>
                    </TablixCell>
                    <TablixCell />
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="txtSurplusForThePeriodCurrent">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=
((Sum(IIF(Fields!major_account_group_name.Value = CStr("Tax Revenue").Trim(), 
CDbl(Fields!current_amount.Value), 0))
+
Sum(IIF(Fields!account_name.Value = CStr("Share from Internal Revenue Collections (IRA)").Trim(), 
CDbl(Fields!current_amount.Value), 0))
+
Sum(IIF(Fields!major_account_group_name.Value = CStr("Service and Business Income").Trim(), 
CDbl(Fields!current_amount.Value), 0))
+
Sum(IIF(Fields!major_account_group_name.Value = CStr("Shares, Grants and Donations").Trim(),
CDbl(Fields!current_amount.Value), 0))
+
Sum(IIF(Fields!major_account_group_name.Value = CStr("Gains").Trim(), 
CDbl(Fields!current_amount.Value), 0))
+
Sum(IIF(Fields!major_account_group_name.Value = CStr("Miscellaneous Income").Trim(),
CDbl(Fields!current_amount.Value), 0)))

-
(Sum(IIF(Fields!major_account_group_name.Value = CStr("Personnel Services").Trim(), 
CDbl(Fields!current_amount.Value), 0))
+
Sum(IIF(Fields!sub_major_account_group_name.Value &lt;&gt; CStr("Financial Assistance/Subsidy").Trim()
AND Fields!sub_major_account_group_name.Value &lt;&gt; CStr("Transfers").Trim()
AND Fields!major_account_group_name.Value = CStr("Maintenance and Other Operating Expenses"),
CDbl(Fields!current_amount.Value), 0))
+
Sum(IIF(Fields!sub_major_account_group_name.Value = CStr("Depreciation").Trim()
OR Fields!sub_major_account_group_name.Value = CStr("Amortization").Trim(),
CDbl(Fields!current_amount.Value), 0))
+
Sum(IIF(Fields!sub_major_account_group_name.Value = CStr("Financial Expenses").Trim(),
CDbl(Fields!current_amount.Value), 0))))


+

(SUM(IIF(Fields!major_account_group_name.Value = CStr("Transfers and Subsidy").Trim(), 
CDbl(Fields!current_amount.Value), 0))

+

-(Sum(IIF(Fields!sub_major_account_group_name.Value = CStr("Financial Assistance/Subsidy").Trim() 
OR Fields!sub_major_account_group_name.Value = CStr("Transfers").Trim(), 
CDbl(Fields!current_amount.Value), 0))))</Value>
                                  <Style>
                                    <FontFamily>Calibri</FontFamily>
                                    <Format>#,0.00;(#,0.00);'-'</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Center</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
