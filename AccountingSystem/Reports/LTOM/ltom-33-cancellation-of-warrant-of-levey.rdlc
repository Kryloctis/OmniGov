          </Textbox>
          <Textbox Name="Textbox18">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>              This is to inform that the Warrant of Levy dated </Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                      <FontWeight>Normal</FontWeight>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=Parameters!paramWarrantOfLeveyDate.Value</Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                      <FontWeight>Bold</FontWeight>
                      <TextDecoration>Underline</TextDecoration>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value> issued on the property covered by Tax Declaration Number </Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                      <FontWeight>Normal</FontWeight>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=Parameters!paramTaxDecNo.Value</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>calibri</FontFamily>
                      <FontWeight>Bold</FontWeight>
                      <TextDecoration>Underline</TextDecoration>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value> and Transfer Certificate of Title (TCT) No. </Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                      <FontWeight>Normal</FontWeight>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=Parameters!paramTCTNo.Value</Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                      <FontWeight>Bold</FontWeight>
                      <TextDecoration>Underline</TextDecoration>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value> was cancelled due to the exercise of redemption by the declared onwner/s.</Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                      <FontWeight>Normal</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
                <SpaceAfter>2pt</SpaceAfter>
                <Style />
              </Paragraph>
