          <Textbox Name="Textbox1">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>I, </Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=Parameters!paramNameOfBidder.Value</Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value> , of legal age, Filipino, Single/Married, and a resident of </Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=Parameters!paramCompleteAddressOfBidder.Value</Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>, after being sworn in accordance with law, depose and say :</Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>Textbox1</rd:DefaultName>
            <Top>0.53173in</Top>
            <Left>0.0127in</Left>
            <Height>0.25in</Height>
            <Width>7.74908in</Width>
            <ZIndex>3</ZIndex>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
              <PaddingLeft>2pt</PaddingLeft>
              <PaddingRight>2pt</PaddingRight>
              <PaddingTop>2pt</PaddingTop>
              <PaddingBottom>2pt</PaddingBottom>
            </Style>
          </Textbox>
          <Textbox Name="Textbox2">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>That I am a registered bidder during the public auction of delinquent real properties on </Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=Parameters!paramActualDateOfPublicAuction.Value</Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>, at </Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=Parameters!paramPlaceOfPublicAuction.Value</Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>.</Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                    </Style>
                  </TextRun>
                </TextRuns>
                <ListStyle>Numbered</ListStyle>
                <ListLevel>1</ListLevel>
                <SpaceAfter>10pt</SpaceAfter>
                <Style>
                  <TextAlign>Left</TextAlign>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>That I am informed of the status, condition, and ownership of the real property/ies sold during the above Public Auction, and I am aware of, acknowledge and accept the terms and condition of the said Public Auction as provided for under the Rules and Regulation of Public Auction as promolugated by the Local Auction Committee. </Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                    </Style>
                  </TextRun>
                </TextRuns>
                <ListStyle>Numbered</ListStyle>
                <ListLevel>1</ListLevel>
                <SpaceAfter>10pt</SpaceAfter>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>That I acknowledge the and I understand the provisions provided under the Rules and Regulation of Public Auction provided; </Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                    </Style>
                  </TextRun>
                </TextRuns>
                <ListStyle>Numbered</ListStyle>
                <ListLevel>1</ListLevel>
                <SpaceAfter>10pt</SpaceAfter>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>That I hereby udnetake to pay the bid price that I will successfully bid for, otherwise, the property/ies sold to me shall be awarded to the LGU concered;</Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                    </Style>
                  </TextRun>
                </TextRuns>
                <ListStyle>Numbered</ListStyle>
                <ListLevel>1</ListLevel>
                <SpaceAfter>10pt</SpaceAfter>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Further, I am aware and understand that the registration fee of the said public auction is non-deductible from the bid price; and </Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                    </Style>
                  </TextRun>
                </TextRuns>
                <ListStyle>Numbered</ListStyle>
                <ListLevel>1</ListLevel>
                <SpaceAfter>10pt</SpaceAfter>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>That I executed this document to attest to the truth of the foregoing and for whatever legal purpose this may serve.</Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                    </Style>
                  </TextRun>
                </TextRuns>
                <ListStyle>Numbered</ListStyle>
                <ListLevel>1</ListLevel>
                <SpaceAfter>10pt</SpaceAfter>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value />
                    <Style>
                      <FontFamily>calibri</FontFamily>
                    </Style>
                  </TextRun>
                </TextRuns>
                <ListLevel>1</ListLevel>
                <Style />
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>Textbox2</rd:DefaultName>
            <Top>0.89632in</Top>
            <Left>0.0127in</Left>
            <Height>2.55208in</Height>
            <Width>7.74908in</Width>
            <ZIndex>4</ZIndex>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
              <PaddingLeft>2pt</PaddingLeft>
              <PaddingRight>2pt</PaddingRight>
              <PaddingTop>2pt</PaddingTop>
              <PaddingBottom>2pt</PaddingBottom>
            </Style>
          </Textbox>
          <Textbox Name="Textbox3">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>IN WITNESS WHEREOF</Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>, I have hereunto set my hand this day of </Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=Parameters!paramSetDay.Value</Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value> day of </Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=Parameters!paramSetMonthOf.Value</Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>, </Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=Parameters!paramSetYear.Value</Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>.</Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                    </Style>
                  </TextRun>
                </TextRuns>
                <ListLevel>1</ListLevel>
                <Style />
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>Textbox3</rd:DefaultName>
