  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Textbox Name="Textbox3">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>The public auction was held on </Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>[@paramDateOfPublicAuction]</Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                      <FontWeight>Bold</FontWeight>
                      <TextDecoration>Underline</TextDecoration>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value xml:space="preserve"> </Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>at and the subject delinquent real property was sold to Mr./Ms. </Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>[@paramBuyer]</Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                      <FontWeight>Bold</FontWeight>
                      <TextDecoration>Underline</TextDecoration>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value> a citizen of the Philippines, of legal age and a resident </Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>[@paramBuyerAddress]</Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                      <FontWeight>Bold</FontWeight>
                      <TextDecoration>Underline</TextDecoration>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value> of being the hightest bidder thereof, for total consideration of  </Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>[@paramSoldPrice]</Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                      <FontWeight>Bold</FontWeight>
                      <TextDecoration>Underline</TextDecoration>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value> , payment is hereby acknowledge received per Official Receipt No. </Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>[@paramOfficialReceiptNo]</Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                      <FontWeight>Bold</FontWeight>
                      <TextDecoration>Underline</TextDecoration>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>, dated </Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>[@paramSoldDate]</Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                      <FontWeight>Bold</FontWeight>
                      <TextDecoration>Underline</TextDecoration>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>, sufficient to satisfy the amount of taxes, interest due or penalties and expenses of sale thereon, itemized as follows:  </Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Center</TextAlign>
                  <LineHeight>150pt</LineHeight>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value />
                    <Style>
                      <FontFamily>calibri</FontFamily>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Center</TextAlign>
                  <LineHeight>150pt</LineHeight>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>For year/s , the real property tax (RPT) delinquency, including penalty/ies and expenses of sale is computed as follows :</Value>
                    <Style>
                      <FontFamily>calibri</FontFamily>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Center</TextAlign>
                  <LineHeight>150pt</LineHeight>
                </Style>
              </Paragraph>
            </Paragraphs>
